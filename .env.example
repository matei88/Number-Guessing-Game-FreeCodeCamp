# ── Google AI ──────────────────────────────────────────────────────────────
# Option A: Vertex AI (recommended for production)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Option B: Google AI Studio (simpler for local dev)
# GOOGLE_API_KEY=your-api-key

# Model override (defaults to gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# ── PostgreSQL ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/data_assistant

# ── Langfuse observability ─────────────────────────────────────────────────
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
